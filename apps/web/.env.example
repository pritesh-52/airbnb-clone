# Base URL of the API, used by server components during rendering.
API_URL=http://localhost:4000/api/v1

# Base URL the browser uses for client-side calls (quote pricing, pagination).
# In development this points at the API directly; behind a proxy it can be a
# same-origin path such as /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Slug of the listing rendered at `/`.
NEXT_PUBLIC_LISTING_SLUG=romantic-jacuzzi-1bhk-candolim
