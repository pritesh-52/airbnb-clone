{
  "name": "@airbnb-clone/web",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js App Router front end for the Airbnb listing page clone.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "clean": "rimraf .next .turbo out"
  },
  "dependencies": {
    "@airbnb-clone/types": "*",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
